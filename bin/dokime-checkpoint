#!/usr/bin/env bash
# dokime-checkpoint — the single advance-call (dokime v2, BL4).
#
# The dokime workflow calls this at every CHECKPOINT, instead of
# scattered "call record-X" directives. It always records the
# checkpoint outcome; step-specific flags add the other records.
#
# Usage:
#   dokime-checkpoint <run_id> <ticket_id> <step> <outcome>
#                     [--note <note>]
#                     [--escaped-ambiguity <origin_ticket_id> <origin_step> <description>]
#                     [--comprehension <result> <difficulty>]
#                     [--card <concept> <deck> <description> [--card-project <project>]]
#                     [--review <concept> <deck> <result> <difficulty> [<target_difficulty>]]   (repeatable, T7+T8)
#                     [--target-difficulty <bloom>]                       (T8, applies to --comprehension)
#                     [--comprehension-pass <pass>]                       (T9, applies to --comprehension)
#                     [--card-label <label>]                              (T9, applies to --card)
#
#   <outcome>    ∈ approved-clean | approved-with-changes | reopened
#   <result>     ∈ pass | fail   (inside --comprehension or --review)
#   <difficulty> ∈ recall | apply | analyze | evaluate
#   <deck>       ∈ codebase | skill
#   <bloom>      ∈ recall | apply | analyze | evaluate
#   <pass>       ∈ silent | what | how | why
#   <label>      ∈ essential_detail | most_common_mistake | safety_tip | none
#
# --target-difficulty (T8): applies to --comprehension. When present, the
# --comprehension record bumps to schema_version=2 carrying target_difficulty.
# For each --review, the *per-card* target is carried as the optional 5th
# positional arg of --review itself (different cards may need different
# targets within the same call — Step 7's review-up-to-3 case).
#
# --comprehension-pass (T9): applies to --comprehension. When present, the
# --comprehension record bumps to schema_version=3 carrying pass (and
# target_difficulty if also set). Identifies which of the four delivery
# passes (Silent → What → How → Why) produced the recorded question.
#
# --card-label (T9): applies to --card. When present, the card is written
# with schema_version=2 and the label field. Categorises the card by its
# discriminating function (essential_detail / most_common_mistake / safety_tip).
#
# The card's `result` is taken from --comprehension; --card therefore
# requires --comprehension. The cross-cutting-concept skip from T6
# is achieved simply by omitting --card.
#
# --review (T7): each repetition reviews ONE existing card from
# ~/.dokime/knowledge/cards.json. Emits one comprehension-check record
# (step set to `<step>:review`) and one card update via capture-card,
# reusing the existing card's description (and project, for codebase
# cards). A --review on a missing card exits non-zero. Reviews never
# emit checkpoint-outcomes records — the cross-check stays clean.
#
# Sub-call failures propagate non-zero (set -e).
set -euo pipefail

run_id="${1:-}"
ticket_id="${2:-}"
step="${3:-}"
outcome="${4:-}"

if [[ -z "$run_id" || -z "$ticket_id" || -z "$step" || -z "$outcome" ]]; then
  echo "usage: dokime-checkpoint <run_id> <ticket_id> <step> <outcome>" \
       "[--note <note>]" \
       "[--escaped-ambiguity <origin_ticket_id> <origin_step> <description>]" \
       "[--comprehension <result> <difficulty>]" \
       "[--card <concept> <deck> <description> [--card-project <project>]]" \
       "[--review <concept> <deck> <result> <difficulty> [<target_difficulty>]]   (repeatable)" \
       "[--target-difficulty <bloom>]" \
       "[--comprehension-pass <pass>]" \
       "[--card-label <label>]" >&2
  exit 2
fi

shift 4 || true

note=""
have_ea=0; ea_origin_ticket=""; ea_origin_step=""; ea_description=""
have_comp=0; comp_result=""; comp_difficulty=""
have_card=0; card_concept=""; card_deck=""; card_description=""
card_project=""
review_concepts=(); review_decks=(); review_results=(); review_difficulties=(); review_targets=()
target_difficulty=""
comp_pass=""
card_label=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --note)
      note="${2:-}"; shift 2 ;;
    --escaped-ambiguity)
      ea_origin_ticket="${2:-}"; ea_origin_step="${3:-}"; ea_description="${4:-}"
      have_ea=1; shift 4 ;;
    --comprehension)
      comp_result="${2:-}"; comp_difficulty="${3:-}"
      have_comp=1; shift 3 ;;
    --card)
      card_concept="${2:-}"; card_deck="${3:-}"; card_description="${4:-}"
      have_card=1; shift 4 ;;
    --card-project)
      card_project="${2:-}"; shift 2 ;;
    --review)
      review_concepts+=("${2:-}")
      review_decks+=("${3:-}")
      review_results+=("${4:-}")
      review_difficulties+=("${5:-}")
      # Optional 5th positional — per-review target_difficulty.
      # Recognised only if present and not the start of another flag.
      if [[ "${6:-}" != "" && "${6:-}" != --* ]]; then
        review_targets+=("$6")
        # Validate per-review target enum eagerly.
        case "$6" in
          recall | apply | analyze | evaluate) ;;
          *) echo "dokime-checkpoint: invalid --review target_difficulty '$6'" \
                  "(expected recall | apply | analyze | evaluate)" >&2
             exit 2 ;;
        esac
        shift 6
      else
        review_targets+=("")
        shift 5
      fi
      ;;
    --target-difficulty)
      target_difficulty="${2:-}"; shift 2 ;;
    --comprehension-pass)
      comp_pass="${2:-}"; shift 2 ;;
    --card-label)
      card_label="${2:-}"; shift 2 ;;
    *)
      echo "dokime-checkpoint: unknown argument '$1'" >&2
      exit 2 ;;
  esac
done

# Validate --target-difficulty enum early (before any sub-dispatch).
if [[ -n "$target_difficulty" ]]; then
  case "$target_difficulty" in
    recall | apply | analyze | evaluate) ;;
    *) echo "dokime-checkpoint: invalid --target-difficulty '$target_difficulty'" \
            "(expected recall | apply | analyze | evaluate)" >&2
       exit 2 ;;
  esac
fi

# Validate --comprehension-pass enum early (T9).
if [[ -n "$comp_pass" ]]; then
  case "$comp_pass" in
    silent | what | how | why) ;;
    *) echo "dokime-checkpoint: invalid --comprehension-pass '$comp_pass'" \
            "(expected silent | what | how | why)" >&2
       exit 2 ;;
  esac
fi

# Validate --card-label enum early (T9).
if [[ -n "$card_label" ]]; then
  case "$card_label" in
    essential_detail | most_common_mistake | safety_tip | none) ;;
    *) echo "dokime-checkpoint: invalid --card-label '$card_label'" \
            "(expected essential_detail | most_common_mistake | safety_tip | none)" >&2
       exit 2 ;;
  esac
fi

# --card needs --comprehension (the card's result comes from --comprehension).
if [[ $have_card -eq 1 && $have_comp -eq 0 ]]; then
  echo "dokime-checkpoint: --card requires --comprehension (the card's result is taken from --comprehension's <result>)" >&2
  exit 2
fi

bin_dir="$(dirname "$0")"

# 1) Always — record the checkpoint outcome.
if [[ -n "$note" ]]; then
  "$bin_dir/record-checkpoint" "$run_id" "$ticket_id" "$step" "$outcome" "$note"
else
  "$bin_dir/record-checkpoint" "$run_id" "$ticket_id" "$step" "$outcome"
fi

# 2) Optionally — escaped-ambiguity record.
if [[ $have_ea -eq 1 ]]; then
  "$bin_dir/record-escaped-ambiguity" \
    "$run_id" "$ticket_id" "$ea_origin_ticket" "$ea_origin_step" "$ea_description"
fi

# 3) Optionally — the comprehension check result.
if [[ $have_comp -eq 1 ]]; then
  # Branches by which T-fields are set (record-comprehension-check accepts
  # target_difficulty as 6th positional and pass as 7th positional).
  if [[ -n "$comp_pass" ]]; then
    "$bin_dir/record-comprehension-check" \
      "$run_id" "$ticket_id" "$step" "$comp_result" "$comp_difficulty" \
      "$target_difficulty" "$comp_pass"
  elif [[ -n "$target_difficulty" ]]; then
    "$bin_dir/record-comprehension-check" \
      "$run_id" "$ticket_id" "$step" "$comp_result" "$comp_difficulty" "$target_difficulty"
  else
    "$bin_dir/record-comprehension-check" \
      "$run_id" "$ticket_id" "$step" "$comp_result" "$comp_difficulty"
  fi
fi

# 4) Optionally — the card (uses --comprehension's result).
# T9: forward --card-label to capture-card as --label when set.
if [[ $have_card -eq 1 ]]; then
  capture_args=("$card_concept" "$card_deck" "$comp_result" "$card_description")
  if [[ -n "$card_project" ]]; then
    capture_args+=("$card_project")
  fi
  if [[ -n "$card_label" ]]; then
    capture_args+=("--label" "$card_label")
  fi
  "$bin_dir/capture-card" "${capture_args[@]}"
fi

# 5) Optionally — process any --review entries (T7).
# Each review looks up an existing card (reviews never invent), emits a
# comprehension-check record with step suffixed ":review", and updates the
# card via capture-card. Reviews never emit checkpoint-outcomes records.
if [[ ${#review_concepts[@]} -gt 0 ]]; then
  cards_file="$HOME/.dokime/knowledge/cards.json"
  for i in "${!review_concepts[@]}"; do
    r_concept="${review_concepts[$i]}"
    r_deck="${review_decks[$i]}"
    r_result="${review_results[$i]}"
    r_difficulty="${review_difficulties[$i]}"

    if [[ ! -f "$cards_file" ]]; then
      echo "dokime-checkpoint: --review failed — no cards file at $cards_file" >&2
      exit 2
    fi
    r_description=$(jq -r --arg concept "$r_concept" \
      '.[] | select(.concept == $concept) | .description // empty' "$cards_file")
    if [[ -z "$r_description" ]]; then
      echo "dokime-checkpoint: --review failed — no card found for concept '$r_concept'" >&2
      exit 2
    fi
    r_project=$(jq -r --arg concept "$r_concept" \
      '.[] | select(.concept == $concept) | .project // empty' "$cards_file")

    # Comprehension record — step suffixed ":review". Per-review target
    # comes from review_targets (the 5th positional of --review), NOT the
    # top-level --target-difficulty (which applies to --comprehension only).
    r_target="${review_targets[$i]}"
    if [[ -n "$r_target" ]]; then
      "$bin_dir/record-comprehension-check" \
        "$run_id" "$ticket_id" "$step:review" "$r_result" "$r_difficulty" "$r_target"
    else
      "$bin_dir/record-comprehension-check" \
        "$run_id" "$ticket_id" "$step:review" "$r_result" "$r_difficulty"
    fi

    # Card update — via capture-card (pass promotes, fail resets).
    if [[ -n "$r_project" ]]; then
      "$bin_dir/capture-card" "$r_concept" "$r_deck" "$r_result" "$r_description" "$r_project"
    else
      "$bin_dir/capture-card" "$r_concept" "$r_deck" "$r_result" "$r_description"
    fi
  done
fi
